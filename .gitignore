# ROS 2 / colcon
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# IDE / editor
.vscode/
.idea/
*.swp

# rosbags & large captures
*.db3
*.mcap
bags/

# secrets
.env
*.key

# URSim: fetched by sim/ursim/get_urcap.sh, not committed
sim/ursim/urcaps/*.urcap

# Vendored third-party ROS packages: fetched by scripts/vendor_import.sh
# (ur7e.repos), not committed — same treatment as apt-installed deps.
src/vendor/

# lab_console.py taught poses are per-session, per-robot state, not source
scripts/.console_poses.json

# host-side voice client environment (scripts/voice_input.py)
.venv-voice/
scripts/.voice_inbox.txt

# lab calibration session files (per camera position / per day); the
# calibrations that produced recorded results live under docs/evidence/
scripts/.lab_camera.json
scripts/.lab_touches.json
scripts/lab_table.json
