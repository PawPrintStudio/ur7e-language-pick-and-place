<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_interfaces</name>
  <version>0.1.0</version>
  <description>
    Message and service definitions shared by the arm_* nodes. Interface
    packages must be ament_cmake (rosidl only generates from CMake), so this
    package holds nothing but .msg/.srv files — keeping every Python node an
    ament_python package.
  </description>
  <maintainer email="nikolamarkovic.idea@gmail.com">Nikola Markovic</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Format 3 requires member_of_group after every *_depend tag. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
