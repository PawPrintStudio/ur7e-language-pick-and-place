<?xml version="1.0"?>
<!--
The real tool stack on the UR7e flange (2026-10-08): an OnRobot Dual Quick
Changer v3 with the RG2 on one face and a 4-finger soft gripper on the other,
each tool 60 deg off the flange axis (photos and CAD: docs/vendor/cad/).

Shared by the Gazebo robot (ur7e_gazebo/urdf/ur7e_gz.urdf.xacro) and the
MoveIt robot it plans with (ur7e_pick_place_bringup/urdf/ur7e_pick_place.urdf.xacro),
so both see the same geometry. The numbers are the ones scripts/lab_tooling.py
computes from the CAD (scripts/test_lab_tooling.py checks they agree):

* tool face centres (+-34.6, 0, 59.7) mm in tool0, normals 60 deg off tool0 Z;
* RG2 on the +x face; its base is additionally rolled -90 deg about its own
  axis, the roll the single-gripper model used, so the jaws keep their
  direction relative to the changer's V;
* changer and soft-gripper visuals are the manufacturer CAD (meshes exported
  from the STEP files), collisions are padded boxes.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:property name="dqc_face_x" value="0.0346"/>
  <xacro:property name="dqc_face_z" value="0.0597"/>
  <xacro:property name="dqc_tilt" value="${pi / 3}"/>
  <xacro:property name="dqc_tool_side" value="0.0284"/>

  <!-- tool0 -> RG2 base (onrobot_base_link). Use as the origin of the
       onrobot_base_link_joint in place of the old on-axis mount. -->
  <xacro:macro name="rg2_on_dual_quick_changer_origin">
    <origin xyz="${dqc_face_x} 0 ${dqc_face_z}" rpy="${-dqc_tilt} 0 ${-pi / 2}"/>
  </xacro:macro>

  <xacro:macro name="dual_quick_changer" params="prefix">
    <link name="${prefix}lab_changer">
      <visual>
        <!-- STEP frame: +Y is the flange axis, robot face at Y = 49 mm. -->
        <origin xyz="0 0 0.049" rpy="${-pi / 2} 0 0"/>
        <geometry>
          <mesh filename="package://ur7e_bringup/meshes/dual_quick_changer_v3.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dqc_aluminium"><color rgba="0.75 0.77 0.8 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.051" rpy="0 0 0"/>
        <geometry><box size="0.138 0.081 0.102"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.41"/>
        <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0009" iyz="0" izz="0.0007"/>
      </inertial>
    </link>
    <joint name="${prefix}lab_changer_joint" type="fixed">
      <parent link="${prefix}tool0"/>
      <child link="${prefix}lab_changer"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- The second tool: soft gripper on the -x face, behind a Quick Changer
         tool side. Only ever avoided, never commanded. -->
    <link name="${prefix}lab_soft_gripper">
      <visual>
        <origin xyz="0 0 ${dqc_tool_side / 2}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.036" length="${dqc_tool_side}"/></geometry>
        <material name="dqc_tool_side"><color rgba="0.35 0.45 0.6 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 ${dqc_tool_side}" rpy="${-pi / 2} 0 0"/>
        <geometry>
          <mesh filename="package://ur7e_bringup/meshes/soft_gripper.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <!-- Blue-grey, not the real saturated blue: in Gazebo the colour
             detector would otherwise take it for "the blue block". -->
        <material name="soft_gripper_blue"><color rgba="0.4 0.6 0.85 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.0732" rpy="0 0 0"/>
        <geometry><box size="0.104 0.104 0.1464"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.07" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0003"/>
      </inertial>
    </link>
    <joint name="${prefix}lab_soft_gripper_joint" type="fixed">
      <parent link="${prefix}tool0"/>
      <child link="${prefix}lab_soft_gripper"/>
      <origin xyz="${-dqc_face_x} 0 ${dqc_face_z}" rpy="0 ${-dqc_tilt} 0"/>
    </joint>
  </xacro:macro>
</robot>
