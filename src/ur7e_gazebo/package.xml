<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur7e_gazebo</name>
  <version>0.1.0</version>
  <description>
    Task 1.8: the tier-3 (Gazebo Fortress) glue D7 in docs/ARCHITECTURE.md
