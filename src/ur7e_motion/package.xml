<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur7e_motion</name>
  <version>0.1.0</version>
  <description>
    motion_node (task 1.5): an ExecutePrimitive action server over pymoveit2
    implementing the arm's motion primitives (goto named pose, approach
    above, cartesian descend/lift, retreat).
  </description>
  <maintainer email="nikolamarkovic.idea@gmail.com">Nikola Markovic</maintainer>
  <license>MIT</license>

  <exec_depend>ur7e_interfaces</exec_depend>
  <exec_depend>pymoveit2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
