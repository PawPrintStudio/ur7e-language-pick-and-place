<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur7e_orchestrator</name>
  <version>0.1.0</version>
  <description>
    Orchestrator (tasks 4.1 and 4.2): the standardized pick workflow as a
    pure-Python state machine with per-stage timeouts, run IDs, structured
    logging, a failure/retry policy, and a dry-run mode against mock adapters.
  </description>
  <maintainer email="nikolamarkovic.idea@gmail.com">Nikola Markovic</maintainer>
  <license>MIT</license>

  <!-- No exec_depend on purpose: the state machine is standard-library
       Python. ROS only enters through the adapter object handed to it. -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
