<?xml version="1.0"?>
<sdf version="1.7">
  <model name="overhead_camera">
    <static>true</static>
    <!-- Gazebo camera x-forward; pitch +pi/2 makes its optical axis point down. -->
    <pose>0.45 0 1 0 1.5707963267948966 0</pose>
    <link name="link">
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/overhead</topic>
        <camera>
          <horizontal_fov>1.0471975512</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>3.0</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
