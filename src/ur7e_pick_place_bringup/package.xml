<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur7e_pick_place_bringup</name>
  <version>0.1.0</version>
  <description>
    Phase 1 bringup: our deltas on the vendored UR7e+RG2 packages (D6) —
    factory calibration wired in, the gripper's GripperCommand action, named
    poses, pick_ik, and the fixed workspace (table + pick/place objects) as a
    MoveIt planning scene. See README.md for what's ours vs vendored.
  </description>
  <maintainer email="nikolamarkovic.idea@gmail.com">Nikola Markovic</maintainer>
  <license>MIT</license>

  <!-- Vendored packages this wraps (src/vendor, ur7e.repos) -->
  <exec_depend>ur_onrobot_description</exec_depend>
  <exec_depend>ur_onrobot_control</exec_depend>
  <exec_depend>ur_onrobot_moveit_config</exec_depend>
  <exec_depend>onrobot_driver</exec_depend>
  <exec_depend>onrobot_description</exec_depend>

  <exec_depend>ur7e_bringup</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
