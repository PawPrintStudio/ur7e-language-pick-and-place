<?xml version="1.0"?>
<!--
Thin pass-through to the vendored combined URDF
(src/vendor/UR_OnRobot_ROS2/ur_onrobot_description/urdf/ur_onrobot.urdf.xacro,
D6) — exists only so MoveItConfigsBuilder (ur7e_moveit.launch.py) can load
robot_description the same way it loads every other file: by path + xacro
mappings, no custom launch-time Command construction needed.
-->
<robot name="ur_onrobot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="robot_ip" default="xxx.yyy.zzz.www"/>
  <xacro:arg name="ur_type" default="ur7e"/>
  <xacro:arg name="onrobot_type" default="rg2"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="kinematics_parameters_file"
             default="$(find ur7e_bringup)/config/ur7e_calibration.yaml"/>
  <!-- Same defaults as the vendored combined xacro
       (src/vendor/UR_OnRobot_ROS2/ur_onrobot_description/urdf/ur_onrobot.urdf.xacro)
       — its macro requires these explicitly, with no defaults of its own. -->
  <xacro:arg name="joint_limits_parameters_file" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="physical_parameters_file" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_parameters_file" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="script_filename" default="$(find ur_client_library)/resources/external_control.urscript"/>
  <xacro:arg name="input_recipe_filename" default="$(find ur_robot_driver)/resources/rtde_input_recipe.txt"/>
  <xacro:arg name="output_recipe_filename" default="$(find ur_robot_driver)/resources/rtde_output_recipe.txt"/>

  <!-- 2026-10-08: the vendored ur_onrobot macro bolts the RG2 to tool0 on
       the flange axis. The real arm has an OnRobot Dual Quick Changer in
       between (RG2 60 deg off axis, soft gripper on the other face), so its
       body is expanded here with that mount; the vendored file is untouched.
       Gazebo uses the same dual_quick_changer.xacro. -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find onrobot_description)/urdf/onrobot_macro.xacro"/>
  <xacro:include filename="$(find ur7e_bringup)/urdf/dual_quick_changer.xacro"/>

  <link name="world"/>

  <xacro:ur_robot
      robot_ip="$(arg robot_ip)"
      name="$(arg ur_type)"
      parent="world"
      tf_prefix="$(arg tf_prefix)"
      use_fake_hardware="$(arg use_fake_hardware)"
      joint_limits_parameters_file="$(arg joint_limits_parameters_file)"
      kinematics_parameters_file="$(arg kinematics_parameters_file)"
      physical_parameters_file="$(arg physical_parameters_file)"
      visual_parameters_file="$(arg visual_parameters_file)"
      script_filename="$(arg script_filename)"
      output_recipe_filename="$(arg output_recipe_filename)"
      input_recipe_filename="$(arg input_recipe_filename)"
      >
      <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>
  <xacro:onrobot onrobot_type="$(arg onrobot_type)" prefix="$(arg tf_prefix)"
                 use_fake_hardware="$(arg use_fake_hardware)"/>
  <joint name="$(arg tf_prefix)onrobot_base_link_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="$(arg tf_prefix)onrobot_base_link"/>
    <xacro:rg2_on_dual_quick_changer_origin/>
  </joint>
  <xacro:dual_quick_changer prefix="$(arg tf_prefix)"/>
  <!-- Cable connectors on the RG2, as in the vendored macro (its SRDF names them). -->
  <link name="$(arg tf_prefix)cable_connector_0">
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
  </link>
  <joint name="$(arg tf_prefix)cable_connector_0_joint" type="fixed">
    <parent link="$(arg tf_prefix)onrobot_base_link"/>
    <child link="$(arg tf_prefix)cable_connector_0"/>
    <origin xyz="0 -0.035 0.01" rpy="0 0 0"/>
  </joint>
  <link name="$(arg tf_prefix)cable_connector_1">
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
  </link>
  <joint name="$(arg tf_prefix)cable_connector_1_joint" type="fixed">
    <parent link="$(arg tf_prefix)onrobot_base_link"/>
    <child link="$(arg tf_prefix)cable_connector_1"/>
    <origin xyz="0.03 0.0 -0.03" rpy="0 0 0"/>
  </joint>
</robot>
